{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for sidebar, topbar, dialog, and app webviews",
  "webviews": ["sidebar", "topbar", "dialog", "app-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "shell:allow-open",
    "dialog:allow-open"
  ]
}
